{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(curl:*)",
      "Bash(jq:*)",
      "Bash(make:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(fd:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(diff:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(which:*)",
      "Bash(pwd)",
      "Bash(echo:*)",
      "Bash(mkdir:*)",
      "Bash(basename:*)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git stash:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git rebase:*)",
      "Bash(git rev-parse:*)",
      "Bash(git tag:*)",
      "Bash(gh api:*)",
      "Bash(gh repo view:*)",
      "Bash(gh repo list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr status:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue status:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh workflow list:*)",
      "Bash(gh workflow view:*)",
      "Bash(gh release list:*)",
      "Bash(gh release view:*)",
      "Bash(gh search:*)",
      "Bash(gh status:*)",
      "Bash(go get:*)",
      "Bash(go run:*)",
      "Bash(go build:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(go mod:*)",
      "Bash(go list:*)",
      "Bash(go doc:*)",
      "Bash(gofumpt:*)",
      "Bash(golangci-lint run:*)",
      "Bash(task --list)",
      "Bash(task build)",
      "Bash(task test:*)",
      "Bash(task lint)",
      "Bash(task fmt)",
      "Bash(task format)",
      "Bash(task gen:*)",
      "Bash(task go:*)",
      "Bash(task check:*)",
      "Bash(task pr)",
      "Bash(pnpm run:*)",
      "Bash(pnpm install)",
      "Bash(pnpm build)",
      "Bash(pnpm test:*)",
      "Bash(pnpm lint)",
      "Bash(yarn run:*)",
      "Bash(yarn install)",
      "Bash(yarn build)",
      "Bash(yarn test:*)",
      "Bash(yarn lint)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(make deploy:*)",
      "Bash(make release:*)",
      "Bash(make push:*)",
      "Bash(make publish:*)",
      "Bash(gh repo delete*)",
      "Bash(git push *--delete*)",
      "Bash(git push * :*)",
      "Bash(gh api*DELETE*refs/heads*)",
      "Bash(gh api*deletePullRequest*)",
      "Read(.env)",
      "Read(.env.*)"
    ],
    "ask": [
      "Bash(./scripts/tanka/tk apply:*)",
      "Bash(tk apply:*)",
      "Bash(tf-apply:*)",
      "Bash(terraform apply:*)",
      "Bash(kubectl apply:*)",
      "Bash(k apply:*)"
    ]
  },
  "model": "opus[1m]",
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh",
    "padding": 0
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "grafana-enghub@grafana-ai-kit": true,
    "slack@claude-plugins-official": true,
    "hive@hive": true,
    "hive-hooks@hive": false,
    "grafana-airbud@grafana-ai-kit": true,
    "plannotator@plannotator": true
  },
  "extraKnownMarketplaces": {
    "hive": {
      "source": {
        "source": "github",
        "repo": "colonyops/hive"
      }
    },
    "grafana-ai-kit": {
      "source": {
        "source": "github",
        "repo": "grafana/ai-kit"
      }
    },
    "plannotator": {
      "source": {
        "source": "github",
        "repo": "backnotprop/plannotator"
      }
    }
  },
  "agent": "default",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark-daltonized"
}
