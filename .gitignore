home/.config/git/gitk
# gh writes auth into this directory: `hosts.yml` holds `oauth_token` whenever
# the token goes to the file instead of the login keyring (`--insecure-storage`,
# or any host where the keyring is unavailable). This repo is public and gh's
# file set is not fixed across versions — 2.92 also references aliases.yml and
# triage.yml — so allowlist rather than blocklist: nothing here is tracked
# unless named, and only config.yml is non-secret.
home/.config/gh/*
!home/.config/gh/config.yml
# Machine-local Claude Code settings, layered over the tracked settings.json.
# `model` lives here because Claude Code rewrites it often enough that it was
# usually the only line changing in the tracked file. Also covered by a global
# rule in home/.config/git/ignore; repeated here so the repo is self-contained
# before that file is deployed.
home/.claude/settings.local.json
# ~/.config/mise is linked as a whole directory (so mise.lock survives an
# atomic temp-file-rename), which means everything mise writes there lands in
# the repo. These two are machine-local/generated; mise.lock itself IS tracked.
home/.config/mise/locks/
home/.config/mise/miserc.toml
home/.config/.semgrep/

# Tool runtime data (credentials, caches)
home/.config/gcloud/
home/.config/gws/
home/.config/sops/age/keys.txt
home/.config/op/

# Agent skills are ignored by default — most arrive from grafana/ai-kit's
# sync or a tool's own installer, and are re-fetchable rather than managed
# here. Add an exception per skill as it's ready to be checked in.
home/.ai/skills/*
!home/.ai/skills/cleanup-comments/
!home/.ai/skills/collab-plan/
!home/.ai/skills/daily-prep/
!home/.ai/skills/diff-review/
!home/.ai/skills/doc-review/
!home/.ai/skills/meeting-notes/
!home/.ai/skills/meeting-segment-editor/
!home/.ai/skills/msg-review/
!home/.ai/skills/obsidian/
!home/.ai/skills/obsidian-cli/
!home/.ai/skills/telegram/
