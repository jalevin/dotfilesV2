#!/usr/bin/env bash
#
# Imperative macOS setup — the part `mise bootstrap` can't express declaratively.
#
# Everything that is a plain `defaults write <domain> <key> <value>` now lives in
# `[bootstrap.macos.defaults]` in mise.toml, where `mise bootstrap macos defaults
# status` reports per-key drift. What's left here needs one of:
#   - sudo (chflags, PAM)
#   - a composite `-dict-add` value (symbolic hotkeys, message settings)
#   - PlistBuddy
#
# Run via: mise run macos-imperative
#
# resources to find defaults
#   https://wilsonmar.github.io/dotfiles/
#   ~/.macos — https://mths.be/macos
#   https://macos-defaults.com/

set -euo pipefail

# Close any open System Settings panes, to prevent them from overriding
# settings we're about to change
osascript -e 'tell application "System Settings" to quit' || true

# Ask for the administrator password upfront
sudo -v

# Keep-alive: update existing `sudo` time stamp until this script has finished
while true; do sudo -n true; sleep 60; kill -0 "$$" || exit; done 2>/dev/null &

###############################################################################
# Manual steps (cannot be automated)                                          #
###############################################################################

# MANUAL: Require password immediately after sleep / screen saver
# The com.apple.screensaver askForPassword keys have been ignored since macOS 10.13.
# Set this in System Settings > Lock Screen > "Require password after screen saver
# begins or display is turned off".
#
# MANUAL: Enable iCloud Desktop & Documents sync
# System Settings > Apple ID > iCloud > iCloud Drive > Options > "Desktop & Documents
# Folders". macOS requires the UI toggle to activate the sync plumbing.

###############################################################################
# Composite values (-dict-add)                                                #
###############################################################################

# Disable smart quotes in Messages — annoying for messages that contain code
defaults write com.apple.messageshelper.MessageController SOInputLineSettings \
  -dict-add "automaticQuoteSubstitutionEnabled" -bool false

###############################################################################
# Privileged                                                                  #
###############################################################################

# Show the /Volumes folder
sudo chflags nohidden /Volumes

# Show the ~/Library folder
#chflags nohidden ~/Library && xattr -d com.apple.FinderInfo ~/Library

###############################################################################
# Keyboard Shortcuts                                                          #
###############################################################################

# Spotlight hotkey (Cmd+Space) — ENABLED. This used to be disabled to free
# Cmd+Space for Alfred; Alfred is gone and native Spotlight is the launcher, so
# the key has to be handed back or Cmd+Space does nothing.
# 64 = Spotlight search field; params = (ASCII space 32, keycode 49, Cmd 1048576).
# Written with `defaults -dict-add` like the shortcuts below, not PlistBuddy:
# direct plist edits race cfprefsd's cache and get silently dropped.
defaults write com.apple.symbolichotkeys AppleSymbolicHotKeys -dict-add 64 \
  '{enabled=1;value={type=standard;parameters=(32,49,1048576);};}'

# Native macOS area screenshots — keep the two selection-capture shortcuts enabled.
# 30 = Cmd+Shift+4 (selection → file, ~/Downloads/Screenshots)
# 31 = Cmd+Shift+Ctrl+4 (selection → clipboard)
# Written via `defaults ... -dict-add` (goes through cfprefsd) instead of editing the
# plist directly with PlistBuddy — direct edits race cfprefsd's cache and silently get
# dropped, which is exactly what left Cmd+Shift+4 disabled after a prior apply.
# params = (ASCII '4'=52, keycode '4'=21, modifier mask); mask 1179648=Cmd+Shift, 1441792=Cmd+Shift+Ctrl.
defaults write com.apple.symbolichotkeys AppleSymbolicHotKeys -dict-add 30 \
  '{enabled=1;value={type=standard;parameters=(52,21,1179648);};}'
defaults write com.apple.symbolichotkeys AppleSymbolicHotKeys -dict-add 31 \
  '{enabled=1;value={type=standard;parameters=(52,21,1441792);};}'

# Add Do Not Disturb hotkey (Cmd+Shift+D)
# Key 175 = Toggle Do Not Disturb
# Parameters: 100 = 'd', 1179648 = Cmd+Shift modifier
defaults write com.apple.symbolichotkeys AppleSymbolicHotKeys -dict-add 175 "
<dict>
  <key>enabled</key><true/>
  <key>value</key><dict>
    <key>type</key><string>standard</string>
    <key>parameters</key>
    <array>
      <integer>100</integer>
      <integer>2</integer>
      <integer>1179648</integer>
    </array>
  </dict>
</dict>
"

###############################################################################
# Touch ID for sudo                                                           #
###############################################################################

# Enable Touch ID for sudo authentication
if [[ -f /etc/pam.d/sudo_local.template ]]; then
  sudo cp /etc/pam.d/sudo_local.template /etc/pam.d/sudo_local
  sudo sed -i '' 's/^#auth/auth/' /etc/pam.d/sudo_local
  echo "Touch ID for sudo enabled"
fi

###############################################################################
# Apply Changes                                                               #
###############################################################################

# The declarative pass restarts these too (post-defaults hook), but the hotkey
# writes above need it as well when this script runs on its own.
launchctl kickstart -k "gui/$(id -u)/com.apple.Dock.agent" 2>/dev/null || killall Dock 2>/dev/null || true
launchctl kickstart -k "gui/$(id -u)/com.apple.SystemUIServer.agent" 2>/dev/null || killall SystemUIServer 2>/dev/null || true
